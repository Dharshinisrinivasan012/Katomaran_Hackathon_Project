{
  "project_name": "Test",
  "version": "0.0.1",
  "input": {
    "source_type": "video",
    "video_path": "data/samples/entrance.mp4",
    "rtsp_url": "",
    "reconnect_delay_sec": 5,
    "max_reconnect_attempts": 0,
    "frame_width": 0,
    "frame_height": 0,
    "fps_limit": 0
  },
  "detection": {
    "model_path": "models/yolov8n-face.pt",
    "confidence_threshold": 0.5,
    "iou_threshold": 0.45,
    "device": "auto",
    "detection_skip_frames": -1,
    "input_size": 640
  },
  "tracking": {
    "tracker_type": "bytetrack",
    "track_thresh": 0.5,
    "track_buffer": 30,
    "match_thresh": 0.8,
    "frame_rate": 30
  },
  "recognition": {
    "model_name": "buffalo_l",
    "embedding_dim": 512,
    "similarity_threshold": 0.45,
    "min_face_size_px": 40,
    "quality_min_score": 0.3,
    "providers": ["CPUExecutionProvider"]
  },
  "registration": {
    "auto_register_unknown": true,
    "min_detections_before_register": 5,
    "register_cooldown_sec": 30,
    "crop_save_enabled": true,
    "crop_dir": "data/crops"
  },
  "entry_exit": {
    "mode": "line_crossing",
    "entry_line": [[0.1, 0.5], [0.9, 0.5]],
    "exit_line": [[0.1, 0.7], [0.9, 0.7]],
    "direction_entry": "top_to_bottom",
    "direction_exit": "bottom_to_top",
    "debounce_sec": 2.0,
    "min_track_age_frames": 10
  },
  "database": {
    "sqlite_path": "data/sqlite/face_tracker.db",
    "wal_mode": true
  },
  "logging": {
    "level": "INFO",
    "console_enabled": true,
    "file_path": "logs/events.log",
    "rotate_max_bytes": 10485760,
    "rotate_backup_count": 5,
    "log_detections": false,
    "log_embeddings": false
  },
  "paths": {
    "registered_faces_dir": "data/faces",
    "events_snapshot_dir": "data/events",
    "samples_dir": "data/samples"
  },
  "performance": {
    "use_half_precision": false,
    "num_threads": 0,
    "max_pipeline_queue_size": 4
  }
}
