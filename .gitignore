# Secrets and local overrides
.env
.env.*
secrets.json
config.local.json

# Local media (official sample videos are not committed)
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.m4v

# Models (large downloads — document paths in config)
models/
weights/
*.onnx
*.pt
!models/.gitkeep

# Jupyter / temp
.ipynb_checkpoints/
tmp/
temp/

# Submission sample output — keep docs/text/small images, exclude large DB binary
sample_output/*.db
sample_output/*.db-journal

# Temporary config overrides
config_*.json
!config.json

